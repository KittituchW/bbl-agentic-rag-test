# Copy to .env and fill in. NEVER commit .env — the repo is public.

# Which LLM provider to use: "bbl" | "google" | "openai"
LLM_PROVIDER=google

# --- Google AI Studio (OpenAI-compatible endpoint) ---
# Key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here
GOOGLE_MODEL=gemini-3.5-flash-lite
# Risky answers use a stronger model for one grounded verification pass.
GOOGLE_VERIFIER_MODEL=gemini-3.5-flash
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- BBL gateway (provided by the recruitment team) ---
BBL_API_KEY=your-bbl-api-key-here
BBL_BASE_URL=https://apimsdbxcandidate01.azure-api.net/llm
BBL_MODEL=gpt-5-mini

# Reasoning effort, applied to both providers so a swap compares
# architectures rather than reasoning budgets.
# OpenAI: minimal|low|medium|high   Gemini: none|low|medium|high
REASONING_EFFORT=low
VERIFIER_REASONING_EFFORT=low
VERIFIER_TIMEOUT_SECONDS=30
