# Copy to .env and fill in. NEVER commit .env — the repo is public.

# Which LLM provider to use: "bbl" (BBL Azure APIM gateway) or "openai"
LLM_PROVIDER=bbl

# --- BBL gateway (provided by the recruitment team) ---
BBL_API_KEY=your-bbl-api-key-here
BBL_BASE_URL=https://apimsdbxcandidate01.azure-api.net/llm
BBL_MODEL=gpt-5-mini


